# Never version WordPress core, secrets or server state.
wp-config.php
*.sql
*.sql.gz
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/plugins/woocommerce/
wp-content/plugins/elementor*/
wp-content/themes/hello-elementor/
.htaccess

# Generated import payload. Regenerate with:
#   python wordpress/tools/export-catalogue.py
# It is derived entirely from data/catalogue-index.json, data/families.json and
# data/products/*.json, all of which are versioned, so committing 5.8 MB of
# regenerable output would only bloat the repository.
data/*.json
data/*.ndjson

# Built upload packages. Regenerate with:
#   python wordpress/tools/build-packages.py
dist/

# A local copy of the payload staged inside the plugin by the packaging script.
wp-content/plugins/star-electric-core/data/

# Python bytecode from the build tooling.
__pycache__/
*.pyc
